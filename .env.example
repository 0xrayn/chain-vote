# ─── ChainVotes  Environment Variables ────────────────────────────────────────
# Copy this file to .env.local and fill in your values

# Your wallet private key (deployer). DO NOT commit to git!
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Sepolia RPC URL  use Alchemy or Infura for reliability
# Free: https://www.alchemy.com  or  https://app.infura.io
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Etherscan API key  for contract verification (optional but recommended)
# Get one free at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Auto-filled by deploy script (scripts/deploy.ts):
NEXT_PUBLIC_CONTRACT_ADDRESS=

# WalletConnect / Reown Project ID — for mobile wallet support via QR code
# Get one free at https://cloud.reown.com (formerly WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Internal secret to protect POST /api/proposals cache-invalidation endpoint
# Generate any random string: openssl rand -hex 32
# Also set NEXT_PUBLIC_INTERNAL_CACHE_SECRET to the SAME value
INTERNAL_CACHE_SECRET=your-random-secret-here
NEXT_PUBLIC_INTERNAL_CACHE_SECRET=your-random-secret-here
